{
  "name": "alego-tui",
  "version": "0.1.0",
  "description": "Claude Code style terminal UI for the Alego agent harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alego-hub/alego-tui.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build:ink": "npm run build --prefix packages/alego-tui-ink",
    "dev": "npm run build:ink && tsx --watch src/entry.tsx",
    "start": "tsx src/entry.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build:ink",
    "test": "vitest run",
    "pretest:watch": "npm run build:ink",
    "test:watch": "vitest",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build": "npm run build:ink && npm run build:plugin",
    "prepare": "npm run build",
    "verify:boundary": "node scripts/verify-boundary.mjs",
    "e2e": "npm run build && python3 scripts/e2e/run_core.py",
    "e2e:install": "npm run build && python3 scripts/e2e/run_install.py",
    "postinstall": "node scripts/link-alego.mjs",
    "link:alego": "node scripts/link-alego.mjs"
  },
  "dependencies": {
    "@alego-tui/ink": "file:./packages/alego-tui-ink",
    "@nanostores/react": "^1.1.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "nanostores": "^1.2.0",
    "react": "^19.2.4",
    "undici": "^6.25.0",
    "unicode-animations": "^1.0.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.3"
  },
  "main": "dist/plugin.js",
  "files": [
    "bin",
    "dist/plugin.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "alego": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@singula-ai/alego-agent": "^0.1.1-rc.2",
    "@singula-ai/alego-agent-default-model": "^0.1.1-rc.2",
    "@singula-ai/alego-commands": "^0.1.1-rc.2",
    "@singula-ai/alego-llm": "^0.1.1-rc.2",
    "@singula-ai/alego-plan-mode": "^0.1.1-rc.2",
    "@singula-ai/alego-session": "^0.1.1-rc.2",
    "@singula-ai/alego-session-persistence": "^0.1.1-rc.2",
    "@singula-ai/alego-session-projection-cache": "^0.1.1-rc.2",
    "@singula-ai/alego-session-title": "^0.1.1-rc.2",
    "@singula-ai/alego-subagent": "^0.1.1-rc.2",
    "@singula-ai/alego-token-meter": "^0.1.1-rc.2",
    "@singula-ai/alego-tools": "^0.1.1-rc.2",
    "@singula-ai/alego-user-approval": "^0.1.1-rc.2",
    "@singula-ai/alego-user-questions": "^0.1.1-rc.2",
    "@singula-ai/cordis": "^4.0.1",
    "@singula-ai/schemastery": "^3.18.1"
  },
  "bin": {
    "alego-tui": "./bin/alego-tui.js"
  },
  "peerDependenciesMeta": {
    "@singula-ai/alego-agent": {
      "optional": true
    },
    "@singula-ai/alego-agent-default-model": {
      "optional": true
    },
    "@singula-ai/alego-commands": {
      "optional": true
    },
    "@singula-ai/alego-llm": {
      "optional": true
    },
    "@singula-ai/alego-plan-mode": {
      "optional": true
    },
    "@singula-ai/alego-session": {
      "optional": true
    },
    "@singula-ai/alego-session-persistence": {
      "optional": true
    },
    "@singula-ai/alego-session-projection-cache": {
      "optional": true
    },
    "@singula-ai/alego-session-title": {
      "optional": true
    },
    "@singula-ai/alego-subagent": {
      "optional": true
    },
    "@singula-ai/alego-token-meter": {
      "optional": true
    },
    "@singula-ai/alego-tools": {
      "optional": true
    },
    "@singula-ai/alego-user-approval": {
      "optional": true
    },
    "@singula-ai/alego-user-questions": {
      "optional": true
    },
    "@singula-ai/cordis": {
      "optional": true
    },
    "@singula-ai/schemastery": {
      "optional": true
    }
  }
}
